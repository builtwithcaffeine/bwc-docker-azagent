FROM alpine:3.21.3

ENV POWERSHELL_VERSION=7.5.1

# Install dependencies
RUN apk update && apk upgrade && \
    apk add \
    curl \
    bash \
    git \
    pipx \
    python3 \
    python3-dev \
    py3-pip \
    build-base \
    linux-headers \
    gcc \
    icu && \
    \
    # Install PowerShell
    curl -L https://github.com/PowerShell/PowerShell/releases/download/v${POWERSHELL_VERSION}/powershell-${POWERSHELL_VERSION}-linux-musl-x64.tar.gz -o /tmp/powershell.tar.gz && \
    mkdir -p /opt/microsoft/powershell/7 && tar zxf /tmp/powershell.tar.gz -C /opt/microsoft/powershell/7 && \
    chmod +x /opt/microsoft/powershell/7/pwsh && ln -s /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh && rm -f /tmp/powershell.tar.gz && \
    \
    # Install Az module
    pwsh -Command "Set-PSRepository -Name PSGallery -InstallationPolicy Trusted; Install-Module Az -Force -Scope AllUsers" && \
    \
    # Install Azure CLI and Bicep using pipx
    pipx ensurepath && . ~/.bashrc && \
    pipx install azure-cli && az bicep install && \
    rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

# Set default shell
CMD ["pwsh"]
